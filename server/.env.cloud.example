# Copy to server/.env.cloud (gitignored) and fill in. Used by server/scripts/deploy_cloud.sh.

# Supabase → Account → Access Tokens (https://supabase.com/dashboard/account/tokens) → Generate new token.
SUPABASE_ACCESS_TOKEN=

# Supabase → your project → Connect → "Session pooler" connection string, with your database password
# filled in. Looks like: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Stadia Maps (free account, no card): https://client.stadiamaps.com → Manage properties → API key.
STADIA_API_KEY=
